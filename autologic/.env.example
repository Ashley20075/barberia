# Copia este archivo como ".env" (en la misma carpeta, junto a manage.py)
# y reemplaza los valores por los que copiaste de Google Cloud Console.

GOOGLE_OAUTH_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret_aqui
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/calendario/oauth2callback/
GEMINI_API_KEY=clave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Si ya tenías variables de Twilio en tu .env, consérvalas, no las borres:
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+17372508034


# Correo de confirmación de cuentas (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# URL pública que recibirán los usuarios en el enlace de confirmación.
# Déjala vacía para usar automáticamente la URL de la petición.
PUBLIC_BASE_URL=

# No es necesario definir SSL_CERT_FILE manualmente: Django usa certifi
# automáticamente para corregir la validación TLS en macOS/Python 3.14.

# Para macOS + Python 3.14 NO necesitas definir SSL_CERT_FILE:
# el proyecto lo fuerza automáticamente al certificado CA de certifi.
# No desactives la verificación SSL.
